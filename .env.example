# Données football en direct : https://www.football-data.org/client/register
FOOTBALL_DATA_KEY=

# Facultatif : chatbot et compositions générées par Claude
ANTHROPIC_API_KEY=

# Laisser sur false tant qu'une authentification des utilisateurs n'est pas en place.
ENABLE_PUBLIC_AI=false

# Adresses autorisées à appeler le backend depuis un navigateur.
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,https://pronoben.github.io

# Facultatif : flux RSS/Atom HTTPS, séparés par des virgules.
NEWS_FEEDS=

# Activer seulement derrière un proxy maîtrisé qui remplace X-Forwarded-For.
TRUST_PROXY=false

# Serveur MCP (développement local)
MCP_HOST=127.0.0.1
MCP_PORT=8000


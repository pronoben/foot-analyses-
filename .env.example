# Données football (gratuit) : https://www.football-data.org/client/register
# Source principale du chatbot, du classement et du direct.
FOOTBALL_DATA_KEY=

# Chatbot : "free" (gratuit, basé sur des sources) ou "anthropic" (payant).
CHAT_ENGINE=free
ENABLE_PUBLIC_CHAT=true

# Facultatif : IA gratuite Groq (https://console.groq.com/keys).
# Sert seulement à comprendre les questions et à rédiger une phrase ;
# tout chiffre absent des données est rejeté. Sans clé, le chatbot marche quand même.
GROQ_API_KEY=
# FREE_AI_MODEL=llama-3.1-8b-instant
FREE_AI_PER_MINUTE=20
FREE_AI_PER_DAY=500

# Facultatif et payant : chatbot et compositions générées par Claude.
ANTHROPIC_API_KEY=
# Laisser sur false : aucune fonction payante n'est alors accessible.
ENABLE_PUBLIC_AI=false

# Adresses autorisées à appeler le backend depuis un navigateur.
ALLOWED_ORIGINS=http://localhost:8765,http://127.0.0.1:8765,https://pronoben.github.io

# Facultatif : flux RSS/Atom HTTPS, séparés par des virgules.
NEWS_FEEDS=

# Activer seulement derrière un proxy maîtrisé (Render : true).
TRUST_PROXY=false

# Limites par visiteur et plafonds du site (protègent les quotas gratuits).
CHAT_LIMIT_PER_5MIN=8
CHAT_LIMIT_PER_DAY=30
FREE_CHAT_PER_HOUR=300
FREE_CHAT_PER_DAY=1500
# Marge sous la limite officielle de football-data.org (10/minute).
FOOTBALL_DATA_PER_MINUTE=9

# Plafonds de l'IA payante (si ENABLE_PUBLIC_AI=true).
AI_DAILY_BUDGET=150
AI_HOURLY_BUDGET=40
AI_MAX_CONCURRENT=3
# CHAT_MODEL=claude-opus-5-5

# Serveur MCP (développement local)
MCP_HOST=127.0.0.1
MCP_PORT=8000
